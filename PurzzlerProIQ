    # ------------------------------------------------------- timer
    def _timer_seconds(self):
        elapsed = self.timer_elapsed
        if self.timer_running and self.timer_started_at is not None:
            elapsed += time.monotonic() - self.timer_started_at
        return max(0, int(elapsed))

    def _update_timer_display(self):
        total = self._timer_seconds()
        hours, rem = divmod(total, 3600)
        minutes, seconds = divmod(rem, 60)
        self.timer_label.config(text=f"{hours:02d}:{minutes:02d}:{seconds:02d}")
        self.btn_timer_start.config(state="disabled" if self.timer_running else "normal")
        self.btn_timer_stop.config(state="normal" if self.timer_running else "disabled")
        if self.timer_running:
            self.timer_after_id = self.root.after(200, self._update_timer_display)
        else:
            self.timer_after_id = None

    def start_timer(self):
        if self.timer_running:
            return
        self.timer_running = True
        self.timer_started_at = time.monotonic()
        self._update_timer_display()

    def stop_timer(self):
        if not self.timer_running:
            return
        self.timer_elapsed += time.monotonic() - self.timer_started_at
        self.timer_started_at = None
        self.timer_running = False
        if self.timer_after_id is not None:
            try:
                self.root.after_cancel(self.timer_after_id)
            except tk.TclError:
                pass
            self.timer_after_id = None
        self._update_timer_display()

    def reset_timer(self):
        self.timer_running = False
        self.timer_elapsed = 0.0
        self.timer_started_at = None
        if self.timer_after_id is not None:
            try:
                self.root.after_cancel(self.timer_after_id)
            except tk.TclError:
                pass
            self.timer_after_id = None
        self._update_timer_display()

    # ------------------------------------------------------- drawing
    def center(self, r, c):
        return self.layout.center(r, c)

    def cell_at(self, x, y):
        return self.layout.cell_at(x, y)

    def draw_piece(self, cells, color, label=None, halo=False, ghost=None):
        cs = set(cells)
        R, B = CELL * 0.40, CELL * 0.27
        passes = ([(GOLD, R + 5, B + 5)] if halo else []) + [(color, R, B)]
        stip = "gray50" if ghost is not None else ""
        edge = {None: "", True: "#00e676", False: "#ff1744"}[ghost]
        for col, rad, th in passes:
            for r, c in cells:
                cx, cy = self.center(r, c)
                for nb in ((r, c + 1), (r + 1, c)):
                    if nb in cs:
                        nx, ny = self.center(*nb)
                        self.cv.create_line(cx, cy, nx, ny, width=2 * th, fill=col,
                                            stipple=stip)
            for r, c in cells:
                cx, cy = self.center(r, c)
                self.cv.create_oval(cx - rad, cy - rad, cx + rad, cy + rad, fill=col,
                                    outline=edge, width=3 if edge else 1, stipple=stip)
        if label:
            r, c = min(cells)
            cx, cy = self.center(r, c)
            self.cv.create_text(cx, cy, text=label, font=("TkDefaultFont", 16, "bold"),
                                fill="#000" if lum(color) > 150 else "#fff")

    def redraw(self):
        cv = self.cv
        cv.delete("all")
        w, h = self.layout.size()
        cv.create_rectangle(6, 6, w - 6, h - 6, fill="#37474f", outline="#263238", width=3)
        for r, c in self.layout.cells:
            cx, cy = self.center(r, c)
            cv.create_oval(cx - 12, cy - 12, cx + 12, cy + 12, fill="#263238", outline="")
        for i, cells in self.placed.items():
            self.draw_piece(cells, self.pieces[i]["color"])
        for k in range(self.hints):
            i, cells = self.solution[k]
            last = (k == self.hints - 1)
            why = last and self.show_why.get()
            if why:
                for alt in self.steps[k]["alts"]:
                    self.draw_piece(alt, "#ff8a80", ghost=False)
            self.draw_piece(cells, self.pieces[i]["color"], label=str(k + 1), halo=last)
            if why and self.steps[k]["key"]:
                cx, cy = self.center(*self.steps[k]["key"])
                self.cv.create_oval(cx - 31, cy - 31, cx + 31, cy + 31,
                                    outline="#00e5ff", width=4)
        if not self.locked and not self.solving and self.hover is not None:
            cells, ok = self.ghost()
            if cells:
                inside = [p for p in cells if p in self.layout.cells]
                self.draw_piece(inside, self.pieces[self.selected]["color"], ghost=ok)

    def draw_palette(self):
        done = set(self.placed)
        if self.locked:
            done |= {self.solution[k][0] for k in range(self.hints)}
        for i, cv in enumerate(self.pal):
            p = self.pieces[i]
            cv.delete("all")
            col = "#c8c8c8" if i in done else p["color"]
            cells = p["cells"]
            h = max(r for r, c in cells) + 1
            w = max(c for r, c in cells) + 1
            s = min(12, 80 // max(w, 1), 56 // max(h, 1))
            ox, oy = (92 - w * s) / 2, 4 + (56 - h * s) / 2
            for r, c in cells:
                cv.create_oval(ox + c * s + 1, oy + r * s + 1, ox + (c + 1) * s - 1,
                               oy + (r + 1) * s - 1, fill=col, outline="#888")
            cv.create_text(46, 66, text=p["name"] + (" ✓" if i in done else ""),
                           font=("TkDefaultFont", 8), fill="#444")
            sel = (i == self.selected and not self.locked)
            cv.config(highlightbackground="#ffb300" if sel else "#bbb",
                      highlightthickness=3 if sel else 1)

    def refresh(self):
        setup = not self.locked and not self.solving
        for b in (self.btn_rot, self.btn_flip, self.btn_clear, self.btn_lock):
            b.config(state="normal" if setup else "disabled")
        self.card_box.config(state="disabled" if self.solving else "readonly")
        self.layout_box.config(state="disabled" if self.solving else "readonly")
        locked = self.locked and not self.solving
        total = len(self.solution)
        self.btn_hint.config(state="normal" if locked and self.hints < total else "disabled")
        self.btn_all.config(state="normal" if locked and self.hints < total else "disabled")
        for b in (self.btn_undo, self.btn_reset):
            b.config(state="normal" if locked and self.hints > 0 else "disabled")
        for b in (self.btn_other, self.btn_edit):
            b.config(state="normal" if locked else "disabled")
        self.why.config(text=self.steps[self.hints - 1]["text"]
                        if locked and self.hints else "")
        self.draw_palette()
        self.redraw()

    # ---------------------------------------------------- setup input
    def select(self, i):
        self.selected = i
        self.cur = normalize(self.pieces[i]["cells"])

    def select_next(self):
        n = len(self.pieces)
        for k in range(1, n + 1):
            j = (self.selected + k) % n
            if j not in self.placed:
                self.select(j)
                return

    def change_layout(self, idx):
        layout = LAYOUTS[idx]
        if self.solving or layout is self.layout:
            self.layout_var.set(self.layout.name)
            return
        self.set_layout(layout)

    def set_layout(self, layout):
        use_layout(layout)
        self.layout = layout
        self.layout_var.set(layout.name)
        self.table = build_placements(self.pieces)
        self.placed = {}
        self.locked = False
        self.solution, self.steps, self.hints = [], [], 0
        self.hover = None
        w, h = layout.size()
        self.cv.config(width=w, height=h)
        self.card_box.config(values=[c[0] for c in layout.cards])
        self.card_var.set("Load a puzzle card...")
        self.select(0)
        self.set_status(f"{layout.name} board - load a card from the dropdown or place pieces.")
        self.refresh()

    def load_card(self, idx):
        if self.solving or idx < 0:
            return
        label, rows = self.layout.cards[idx]
        if self.locked:
            self.unlock()
        found, bad = card_pieces(rows, self.pieces)
        self.placed = found
        self.hover = None
        free = [i for i in range(len(self.pieces)) if i not in found]
        if free:
            self.select(free[0])
        self.set_status(f"Card {label} loaded: {len(found)} pieces placed, {len(free)} to go. "
                        "Press 'Lock setup & solve'.")
        self.refresh()
        if bad:
            messagebox.showwarning(
                "Shape mismatch",
                "These pieces on the card don't match your current piece shapes: "
                + ", ".join(bad) + ".\nCheck Pieces > Edit piece shapes...")

    def on_palette(self, i):
        if self.locked or self.solving:
            return
        self.placed.pop(i, None)
        self.select(i)
        self.refresh()

    def ghost(self):
        if self.hover is None:
            return None, False
        hr, hc = self.hover
        ar, ac = anchor_of(self.cur)
        cells = [(hr + r - ar, hc + c - ac) for r, c in self.cur]
        taken = {p for cs in self.placed.values() for p in cs}
        ok = all((r, c) in self.layout.cells and (r, c) not in taken for r, c in cells)
        return cells, ok

    def set_hover(self, cell):
        if cell != self.hover:
            self.hover = cell
            if not self.locked and not self.solving:
                self.redraw()

    def on_motion(self, e):
        self.set_hover(self.cell_at(e.x, e.y))

    def on_click(self, e):
        if self.locked or self.solving:
            return
        self.hover = self.cell_at(e.x, e.y)
        cells, ok = self.ghost()
        if cells and ok:
            self.placed[self.selected] = cells
            self.select_next()
            self.set_status(f"Placed. {len(self.placed)} piece(s) on the board.")
            self.refresh()

    def on_right(self, e):
        if self.locked or self.solving:
            return
        cell = self.cell_at(e.x, e.y)
        for i, cells in list(self.placed.items()):
            if cell in cells:
                del self.placed[i]
                self.select(i)
                self.refresh()
                return

    def do_rotate(self):
        if not self.locked and not self.solving:
            self.cur = rotate(self.cur)
            self.redraw()

    def do_flip(self):
        if not self.locked and not self.solving:
            self.cur = flip(self.cur)
            self.redraw()

    def clear_board(self):
        self.placed.clear()
        self.select(0)
        self.set_status("Board cleared.")
        self.refresh()

    def on_key(self, e):
        k = e.keysym.lower()
        if k == "r":
            self.do_rotate()
        elif k == "f":
            self.do_flip()
        elif k == "h":
            self.hint()

    def set_status(self, text):
        self.status.config(text=text)

    # ------------------------------------------------- lock & solve
    def lock_and_solve(self, randomize=False):
        if self.solving:
            return
        filled = 0
        for cells in self.placed.values():
            for r, c in cells:
                filled |= bit(r, c)
        rem = sum(1 << i for i in range(len(self.pieces)) if i not in self.placed)
        sizes = [len(p["cells"]) for p in self.pieces]
        table = self.table
        rng = random.Random() if randomize else None
        deadline = time.time() + 90
        self.cancel.clear()
        self.solving = True
        self.set_status("Solving... (this normally takes well under a second)")
        self.refresh()

        names = [p["name"] for p in self.pieces]

        def work():
            res, steps, err = None, [], None
            try:
                res = solve(table, sizes, filled, rem, rng, deadline, self.cancel)
                if res:
                    steps = plan_hints(table, sizes, filled, rem, res, names, self.cancel)
            except Cancelled:
                err, res = "cancel", None
            except TimeoutError:
                err, res = "timeout", None
            self.root.after(0, lambda: self.solve_done(res, steps, err))

        threading.Thread(target=work, daemon=True).start()

    def solve_done(self, res, steps, err):
        self.solving = False
        if err == "timeout":
            messagebox.showwarning("Solver", "The solver gave up after 90 s.")
        elif res is None and err is None:
            messagebox.showwarning(
                "No solution",
                "This setup cannot be completed.\n\nCheck that the pieces on the board "
                "match your puzzle card. If the card is right, one of the piece shapes "
                "may differ from your physical set (Pieces > Edit piece shapes...).")
        if res is None:
            if self.locked:      # "another solution" failed, keep the old one
                self.set_status("Kept the previous solution.")
            else:
                self.set_status("No solution found - fix the setup and try again.")
            self.refresh()
            return
        self.locked = True
        self.steps = steps
        self.solution = [(st["piece"], st["cells"]) for st in steps]
        self.hints = 0
        self.hover = None
        self.set_status(f"Setup locked. {len(self.solution)} piece(s) left to place - press Hint.")
        self.refresh()

    def unlock(self):
        self.locked = False
        self.solution = []
        self.steps = []
        self.hints = 0
        self.set_status("Setup unlocked - edit the board, then lock again.")
        self.refresh()

    def another(self):
        self.lock_and_solve(randomize=True)

    # ------------------------------------------------------- hints
    def hint(self):
        if not self.locked or self.solving or self.hints >= len(self.solution):
            return
        self.hints += 1
        self.hint_status()
        self.refresh()

    def hint_status(self):
        total = len(self.solution)
        if self.hints == 0:
            self.set_status(f"Setup locked. {total} piece(s) left to place - press Hint.")
        elif self.hints >= total:
            self.set_status(f"Hint {total}/{total}: the {self.pieces[self.solution[-1][0]]['name']} "
                            "piece completes the puzzle!")
        else:
            name = self.pieces[self.solution[self.hints - 1][0]]["name"]
            self.set_status(f"Hint {self.hints}/{total}: place the {name} piece "
                            "(gold outline).")

    def undo_hint(self):
        if self.hints:
            self.hints -= 1
            self.hint_status()
            self.refresh()

    def reset_hints(self):
        self.hints = 0
        self.hint_status()
        self.refresh()

    def show_all(self):
        self.hints = len(self.solution)
        self.hint_status()
        self.refresh()

    # ---------------------------------------------------- piece editor
    def open_editor(self):
        if self.solving:
            return
        PieceEditor(self)

    def set_pieces(self, shapes):
        for p, cells in zip(self.pieces, shapes):
            p["cells"] = normalize(cells)
        save_pieces(self.pieces)
        self.table = build_placements(self.pieces)
        self.placed.clear()
        self.locked = False
        self.solution = []
        self.steps = []
        self.hints = 0
        self.select(0)
        total = sum(len(p["cells"]) for p in self.pieces)
        if total != len(LAYOUT.cells):
            messagebox.showwarning(
                "Piece total", f"The pieces cover {total} cells, but the board has "
                               f"{len(LAYOUT.cells)}. A complete solution is impossible until "
                               "the totals match.")
        self.set_status("Piece shapes updated - board cleared.")
        self.refresh()


