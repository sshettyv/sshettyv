# --------------------------------------------------------------------------
# geometry helpers
# --------------------------------------------------------------------------
def parse(art):
    return [(r, c) for r, line in enumerate(art.split("/"))
            for c, ch in enumerate(line) if ch == "X"]


def normalize(cells):
    mr = min(r for r, c in cells)
    mc = min(c for r, c in cells)
    return tuple(sorted((r - mr, c - mc) for r, c in cells))


def rotate(cells):
    return normalize([(c, -r) for r, c in cells])


def flip(cells):
    return normalize([(r, -c) for r, c in cells])


def orientations(cells):
    """All distinct rotations / reflections of a shape."""
    seen, out = set(), []
    cur = list(cells)
    for _ in range(2):
        for _ in range(4):
            cur = [(c, -r) for r, c in cur]
            n = normalize(cur)
            if n not in seen:
                seen.add(n)
                out.append(n)
        cur = [(r, -c) for r, c in cur]
    return out


def is_connected(cells):
    cells = set(cells)
    if not cells:
        return False
    stack = [next(iter(cells))]
    seen = {stack[0]}
    while stack:
        r, c = stack.pop()
        for d in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            n = (r + d[0], c + d[1])
            if n in cells and n not in seen:
                seen.add(n)
                stack.append(n)
    return len(seen) == len(cells)


def anchor_of(cells):
    """Cell nearest the middle of the shape - used as the mouse 'handle'."""
    mr = max(r for r, c in cells) / 2
    mc = max(c for r, c in cells) / 2
    return min(cells, key=lambda p: ((p[0] - mr) ** 2 + (p[1] - mc) ** 2, p))


def lum(color):
    r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
    return 0.299 * r + 0.587 * g + 0.114 * b


# --------------------------------------------------------------------------
# solver  (bitboard, column-major: bit = col * ROWS + row)
# --------------------------------------------------------------------------
def bit(r, c):
    return 1 << (c * ROWS + r)


ROW0 = ROWL = NOT_ROW0 = NOT_ROWL = 0


def use_layout(layout):
    """Switch the solver to another board shape."""
    global ROWS, COLS, FULL, ROW0, ROWL, NOT_ROW0, NOT_ROWL, LAYOUT
    LAYOUT = layout
    ROWS, COLS = layout.rows, layout.cols
    FULL = 0
    for r, c in layout.cells:
        FULL |= 1 << (c * ROWS + r)
    ROW0 = sum(1 << (c * ROWS) for c in range(COLS))
    ROWL = sum(1 << (c * ROWS + ROWS - 1) for c in range(COLS))
    NOT_ROW0 = FULL & ~ROW0
    NOT_ROWL = FULL & ~ROWL


use_layout(STRAIGHT)


def popcount(x):
    return bin(x).count("1")


def mask_cells(m):
    out = []
    while m:
        b = m & -m
        i = b.bit_length() - 1
        out.append((i % ROWS, i // ROWS))
        m ^= b
    return out


def flood(seed, empty):
    region = seed
    while True:
        grown = (region | ((region << 1) & NOT_ROW0) | ((region >> 1) & NOT_ROWL)
                 | (region << ROWS) | (region >> ROWS)) & empty
        if grown == region:
            return region
        region = grown


def build_placements(pieces):
    """table[piece] = {lowest_bit: [masks of every placement starting there]}"""
    table = []
    for p in pieces:
        by_low = {}
        for o in orientations(p["cells"]):
            h = max(r for r, c in o) + 1
            w = max(c for r, c in o) + 1
            for r0 in range(ROWS - h + 1):
                for c0 in range(COLS - w + 1):
                    m = 0
                    for r, c in o:
                        m |= bit(r0 + r, c0 + c)
                    if m & ~FULL:          # sticks out of the board shape
                        continue
                    by_low.setdefault(m & -m, []).append(m)
        table.append(by_low)
    return table


class Cancelled(Exception):
    pass


def bits_of(m):
    while m:
        b = m & -m
        yield b
        m ^= b


def make_region_check(sizes):
    """Return ok(filled, remaining_mask): every empty pocket must be fillable."""
    n = len(sizes)
    reach_cache = {}

    def reach(rem):
        v = reach_cache.get(rem)
        if v is None:
            v = 1
            for i in range(n):
                if rem >> i & 1:
                    v |= v << sizes[i]
            reach_cache[rem] = v
        return v

    def regions_ok(f, rem):
        r = reach(rem)
        empty = FULL & ~f
        while empty:
            reg = flood(empty & -empty, empty)
            if not (r >> popcount(reg)) & 1:
                return False
            empty &= ~reg
        return True

    return regions_ok


def solve(table, sizes, filled, rem_mask, rng=None, deadline=None, cancel=None):
    """Return [(piece_index, mask), ...] in placement order, or None."""
    n = len(sizes)
    regions_ok = make_region_check(sizes)

    if popcount(FULL & ~filled) != sum(sizes[i] for i in range(n) if rem_mask >> i & 1):
        return None
    if rem_mask and not regions_ok(filled, rem_mask):
        return None

    nodes = 0
    stack = []

    def rec(f, rem):
        nonlocal nodes
        if rem == 0:
            return f == FULL
        nodes += 1
        if nodes & 2047 == 0:
            if cancel is not None and cancel.is_set():
                raise Cancelled()
            if deadline is not None and time.time() > deadline:
                raise TimeoutError()
        empty = FULL & ~f
        if not empty:
            return False
        low = empty & -empty
        ids = [i for i in range(n) if rem >> i & 1]
        if rng:
            rng.shuffle(ids)
        for i in ids:
            masks = table[i].get(low)
            if not masks:
                continue
            if rng:
                masks = rng.sample(masks, len(masks))
            for m in masks:
                if m & f:
                    continue
                nf = f | m
                nrem = rem & ~(1 << i)
                if nrem and not regions_ok(nf, nrem):
                    continue
                stack.append((i, m))
                if rec(nf, nrem):
                    return True
                stack.pop()
        return False

    return list(stack) if rec(filled, rem_mask) else None


def candidates(table, sizes, filled, rem_mask, ok):
    """Every legal (piece, mask) on the current board that doesn't create an
    obviously unfillable pocket."""
    out = []
    for i in range(len(sizes)):
        if not rem_mask >> i & 1:
            continue
        nrem = rem_mask & ~(1 << i)
        for masks in table[i].values():
            for m in masks:
                if m & filled:
                    continue
                if nrem:
                    if not ok(filled | m, nrem):
                        continue
                elif (filled | m) != FULL:
                    continue
                out.append((i, m))
    return out


def plan_hints(table, sizes, filled, rem_mask, solution, names, cancel=None):
    """Order the solution so the most 'forced' placement comes first and attach a
    plain-language reason to every step."""
    ok = make_region_check(sizes)
    left = list(solution)
    steps = []
    f, rem = filled, rem_mask
    while left:
        if cancel is not None and cancel.is_set():
            raise Cancelled()
        cover, per_piece = {}, {}
        for i, m in candidates(table, sizes, f, rem, ok):
            per_piece[i] = per_piece.get(i, 0) + 1
            for b in bits_of(m):
                cover.setdefault(b, []).append((i, m))
        best = None
        for i, m in left:
            kb = min(bits_of(m), key=lambda b: len(cover.get(b, ())))
            kc = len(cover.get(kb, ()))
            pri = 0 if kc == 1 else (1 if per_piece.get(i, 0) == 1 else 2)
            if best is None or (pri, kc) < best[0]:
                best = ((pri, kc), i, m, kb)
        (pri, kc), i, m, kb = best
        idx = kb.bit_length() - 1
        key = (idx % ROWS, idx // ROWS)
        where = LAYOUT.describe(key)
        name = names[i]
        alts = []
        if pri == 0:
            kind = "cell"
            text = (f"{where} can only be covered one way: every other piece "
                    f"and orientation either overlaps something or leaves a gap that can't "
                    f"be filled. That forces the {name} piece here.")
        elif pri == 1:
            kind, key = "piece", None
            text = (f"The {name} piece has only one legal position left on the board - "
                    f"anywhere else it overlaps something or leaves an unfillable gap.")
        else:
            kind = "elim"
            others = [x for x in cover[kb] if x != (i, m)]
            alive = 0
            for ai, am in others:
                try:
                    r2 = solve(table, sizes, f | am, rem & ~(1 << ai), None,
                               time.time() + 2, cancel)
                except TimeoutError:
                    continue
                if r2 is None:
                    alts.append(mask_cells(am))
                else:
                    alive += 1
            text = f"{where} can be covered in {len(others) + 1} different ways. "
            if len(alts) == len(others):
                lead = ("The only other option leads" if len(others) == 1
                        else f"The other {len(others)} all lead")
                text += (f"{lead} to a dead end a few moves later (red outlines), so the "
                         f"{name} piece has to go here.")
            else:
                if alts:
                    text += (f"{len(alts)} of the other {len(others)} lead to a dead end "
                             f"(red outlines). ")
                if alive:
                    text += ("Other options also work here, so this setup has more than one "
                             "solution - this hint follows one of them.")
                else:
                    text += ("The rest couldn't be ruled out quickly; this hint follows a "
                             "verified solution.")
        steps.append({"piece": i, "cells": mask_cells(m), "key": key,
                      "kind": kind, "alts": alts, "text": text})
        f |= m
        rem &= ~(1 << i)
        left.remove((i, m))
    return steps


