class Layout:
    """A board shape: which (row, col) cells exist, how to draw them, its cards."""

    def __init__(self, name, kind, rows, cols, cells, cards):
        self.name, self.kind, self.rows, self.cols = name, kind, rows, cols
        self.cells = frozenset(cells)
        self.cards = cards

    def center(self, r, c):
        if self.kind == "diag":
            s = CELL / math.sqrt(2)
            return (PAD + CELL / 2 + (r + c - 1) * s, PAD + CELL / 2 + (r - c + 4) * s)
        return PAD + c * CELL + CELL / 2, PAD + r * CELL + CELL / 2

    def size(self):
        if self.kind == "diag":
            s = CELL / math.sqrt(2)
            return int(14 * s + CELL + 2 * PAD), int(8 * s + CELL + 2 * PAD)
        return self.cols * CELL + 2 * PAD, self.rows * CELL + 2 * PAD

    def cell_at(self, x, y):
        if self.kind == "diag":
            best = None
            for r, c in self.cells:
                cx, cy = self.center(r, c)
                d = (x - cx) ** 2 + (y - cy) ** 2
                if best is None or d < best[0]:
                    best = (d, (r, c))
            return best[1] if best and best[0] <= (CELL * 0.56) ** 2 else None
        c, r = int((x - PAD) // CELL), int((y - PAD) // CELL)
        if 0 <= r < self.rows and 0 <= c < self.cols and x >= PAD and y >= PAD:
            return r, c
        return None

    def describe(self, rc):
        if self.kind == "diag":
            return "The ringed square"
        return f"The square at row {rc[0] + 1}, column {rc[1] + 1}"


