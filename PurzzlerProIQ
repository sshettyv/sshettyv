def card_pieces(rows, pieces):
    """Return ({piece index: cells}, [names of pieces whose shape doesn't match])."""
    by_name = {p["name"]: i for i, p in enumerate(pieces)}
    found = {}
    for r, row in enumerate(rows):
        for c, ch in enumerate(row):
            if ch in LETTERS:
                found.setdefault(by_name[LETTERS[ch]], []).append((r, c))
    bad = [pieces[i]["name"] for i, cs in found.items()
           if normalize(cs) not in orientations(pieces[i]["cells"])]
    return found, bad


