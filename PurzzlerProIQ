CELL, PAD = 58, 24
CELL, PAD = 50, 24
BOARD_W, BOARD_H = STRAIGHT.size()
GOLD = "#ffd54f"
TS = 24                       # tray piece size (pixels per ball) - change to resize
TRAY_COLS = 3
TRAY_TOP = 34
FREE = "Free play"
PANEL_H = 170                # height reserved under the board for timer / status / hints
SLOT = 4 * TS + 18            # room for the longest piece (4 balls) and its name


def transform(cells, anchor, kind):
    """Rotate ('rot') or mirror ('flip') a shape and keep the 'handle' ball."""
    f = (lambda r, c: (c, -r)) if kind == "rot" else (lambda r, c: (r, -c))
    pts = [f(r, c) for r, c in cells]
    a = f(*anchor)
    mr = min(r for r, c in pts)
    mc = min(c for r, c in pts)
    return (tuple(sorted((r - mr, c - mc) for r, c in pts)), (a[0] - mr, a[1] - mc))


