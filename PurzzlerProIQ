    # ------------------------------------------------------- timer
    def _timer_seconds(self):
        elapsed = self.timer_elapsed
        if self.timer_running and self.timer_started_at is not None:
            elapsed += time.monotonic() - self.timer_started_at
        return max(0, int(elapsed))

    def _update_timer_display(self):
        total = self._timer_seconds()
        hours, rem = divmod(total, 3600)
        minutes, seconds = divmod(rem, 60)
        self.timer_label.config(text=f"{hours:02d}:{minutes:02d}:{seconds:02d}")
        self.btn_timer_start.config(state="disabled" if self.timer_running else "normal")
        self.btn_timer_stop.config(state="normal" if self.timer_running else "disabled")
        if self.timer_running:
            self.timer_after_id = self.root.after(200, self._update_timer_display)
        else:
            self.timer_after_id = None

    def start_timer(self):
        if self.timer_running:
            return
        self.timer_running = True
        self.timer_started_at = time.monotonic()
        self._update_timer_display()

    def stop_timer(self):
        if not self.timer_running:
            return
        self.timer_elapsed += time.monotonic() - self.timer_started_at
        self.timer_started_at = None
        self.timer_running = False
        if self.timer_after_id is not None:
            try:
                self.root.after_cancel(self.timer_after_id)
            except tk.TclError:
                pass
            self.timer_after_id = None
        self._update_timer_display()

    def reset_timer(self):
        self.timer_running = False
        self.timer_elapsed = 0.0
        self.timer_started_at = None
        if self.timer_after_id is not None:
            try:
                self.root.after_cancel(self.timer_after_id)
            except tk.TclError:
                pass
            self.timer_after_id = None
        self._update_timer_display()

    # ------------------------------------------------------- drawing
    def center(self, r, c):
        return self.layout.center(r, c)

    def cell_at(self, x, y):
        return self.layout.cell_at(x, y)

    def draw_piece(self, cells, color, label=None, halo=False, ghost=None, cf=None, k=1.0,
                   outline=None):
        cf = cf or self.center
        cs = set(cells)
        R, B = CELL * 0.40 * k, CELL * 0.27 * k
        passes = ([(GOLD, R + 5 * k, B + 5 * k)] if halo else []) + [(color, R, B)]
        stip = "gray50" if ghost is not None else ""
        edge = {None: "", True: "#00e676", False: "#ff1744"}[ghost]
        for col, rad, th in passes:
            for r, c in cells:
                cx, cy = cf(r, c)
                for nb in ((r, c + 1), (r + 1, c)):
                    if nb in cs:
                        nx, ny = cf(*nb)
                        self.cv.create_line(cx, cy, nx, ny, width=2 * th, fill=col,
                                            stipple=stip)
            for r, c in cells:
                cx, cy = cf(r, c)
                self.cv.create_oval(cx - rad, cy - rad, cx + rad, cy + rad, fill=col,
                                    outline=edge or outline or "",
                                    width=3 if edge else (2 if outline else 1),
                                    stipple=stip)
        if label:
            r, c = min(cells)
            cx, cy = cf(r, c)
            self.cv.create_text(cx, cy, text=label, font=("TkDefaultFont", 16, "bold"),
                                fill="#000" if lum(color) > 150 else "#fff")

    def redraw(self):
        cv = self.cv
        cv.delete("all")
        w, h = self.layout.size()
        # board: dark plate with the holes
        cv.create_rectangle(6, 6, w - 6, h - 6, fill="#231f20", outline="#111", width=3)
        for r, c in self.layout.cells:
            cx, cy = self.center(r, c)
            cv.create_oval(cx - 11, cy - 11, cx + 11, cy + 11, fill="#3b3739", outline="")
        for i, cells in self.placed.items():
            self.draw_piece(cells, self.pieces[i]["color"],
                            outline="#231f20" if i in self.fixed else None)
        n = len(self.hint_steps)
        for k, st in enumerate(self.hint_steps):
            last = (k == n - 1)
            why = last and self.show_why.get()
            if why:
                for alt in st["alts"]:
                    self.draw_piece(alt, "#ff8a80", ghost=False)
            self.draw_piece(st["cells"], self.pieces[st["piece"]]["color"],
                            label=str(k + 1) if n > 1 else None, halo=last)
            if why and st["key"]:
                cx, cy = self.center(*st["key"])
                self.cv.create_oval(cx - 31, cy - 31, cx + 31, cy + 31,
                                    outline="#00e5ff", width=4)
        self.draw_tray()
        if self.drag:
            d = self.drag
            i = d["i"]
            col = self.pieces[i]["color"]
            cells, ok = self.ghost()
            if cells:
                inside = [p for p in cells if p in self.layout.cells]
                if inside:
                    self.draw_piece(inside, col, ghost=ok)
            ax, ay = self.layout.center(*d["anchor"])

            def cf(r, c):
                x, y = self.layout.center(r, c)
                return self.mx + x - ax, self.my + y - ay
            self.draw_piece(self.shape[i], col, cf=cf)

    # ------------------------------------------------------------- tray
    def slot_xy(self, i):
        return (self.tray_x + (i % TRAY_COLS) * SLOT,
                TRAY_TOP + (i // TRAY_COLS) * SLOT)

    def tray_center(self, i):
        sx, sy = self.slot_xy(i)
        cells = self.shape[i]
        w = max(c for r, c in cells) + 1
        h = max(r for r, c in cells) + 1
        ox = sx + (SLOT - w * TS) / 2
        oy = sy + 2 + (4 * TS - h * TS) / 2
        return lambda r, c: (ox + (c + 0.5) * TS, oy + (r + 0.5) * TS)

    def draw_tray(self):
        cv = self.cv
        done = set(self.placed)
        cv.create_text(self.tray_x, 16, anchor="w", text="Pieces - drag onto the board",
                       font=("Arial", 10, "bold"))
        for i, p in enumerate(self.pieces):
            sx, sy = self.slot_xy(i)
            cv.create_rectangle(sx + 2, sy, sx + SLOT - 4, sy + SLOT - 4, outline="#e3e3e3")
            if not (self.drag and self.drag["i"] == i):
                col = "#c8c8c8" if i in done else p["color"]
                self.draw_piece(self.shape[i], col, cf=self.tray_center(i), k=TS / CELL)
            cv.create_text(sx + SLOT / 2 - 1, sy + SLOT - 12, fill="#444",
                           text=p["name"] + (" \u2713" if i in done else ""),
                           font=("Arial", 8))

    def refresh(self):
        idle = not self.solving
        for b in (self.btn_clear, self.btn_hint, self.btn_all):
            b.config(state="normal" if idle else "disabled")
        can_undo = idle and any(i in self.placed and i not in self.fixed
                                for i in self.history)
        self.btn_undo.config(state="normal" if can_undo else "disabled")
        self.card_box.config(state="disabled" if self.solving else "readonly")
        self.layout_box.config(state="disabled" if self.solving else "readonly")
        self.why.config(text=self.hint_steps[-1]["text"] if self.hint_steps else "")
        self.redraw()

    # ------------------------------------------- dragging / placing pieces
    def track(self, e):
        self.mx, self.my = e.x, e.y

    def hit_piece(self, x, y):
        """(piece index, handle ball, 'board' | 'tray') under the mouse, or None.
        Pieces that belong to the loaded card are fixed and are never returned."""
        cell = self.cell_at(x, y)
        if cell is not None:
            for i, cells in self.placed.items():
                if i not in self.fixed and cell in cells:
                    mr = min(r for r, c in cells)
                    mc = min(c for r, c in cells)
                    return i, (cell[0] - mr, cell[1] - mc), "board"
        for i in range(len(self.pieces)):
            if i in self.placed:
                continue
            cf = self.tray_center(i)
            for r, c in self.shape[i]:
                cx, cy = cf(r, c)
                if abs(x - cx) <= TS / 2 and abs(y - cy) <= TS / 2:
                    return i, (r, c), "tray"
        return None

    def ghost(self):
        """Cells the dragged piece would occupy if dropped now, and if that is legal."""
        d = self.drag
        hover = self.cell_at(self.mx, self.my)
        if not d or hover is None:
            return None, False
        ar, ac = d["anchor"]
        cells = [(hover[0] + r - ar, hover[1] + c - ac) for r, c in self.shape[d["i"]]]
        taken = {p for cs in self.placed.values() for p in cs}
        ok = all((r, c) in self.layout.cells and (r, c) not in taken for r, c in cells)
        return cells, ok

    def remember(self, i):
        if i in self.history:
            self.history.remove(i)
        self.history.append(i)

    def on_press(self, e):
        self.track(e)
        if self.solving:
            return
        hit = self.hit_piece(e.x, e.y)
        if not hit:
            return
        i, anchor, src = hit
        if src == "board":
            self.shape[i] = normalize(self.placed.pop(i))
            if i in self.history:
                self.history.remove(i)
        self.hint_steps = []          # the board is changing - old hints are stale
        self.drag = {"i": i, "anchor": anchor}
        self.refresh()

    def on_move(self, e):
        self.track(e)
        if self.drag:
            self.redraw()

    def on_release(self, e):
        self.track(e)
        if not self.drag:
            return
        cells, ok = self.ghost()
        i = self.drag["i"]
        self.drag = None
        if cells and ok:
            self.placed[i] = cells
            self.remember(i)
            self.set_status(f"Placed the {self.pieces[i]['name']} piece. "
                            f"{len(self.placed)}/{len(self.pieces)} pieces on the board.")
        self.refresh()
        self.check_solved()

    def transform_at(self, x, y, kind):
        """Rotate / flip the dragged piece, or the piece under (x, y)."""
        if self.solving:
            return
        if self.drag:
            i = self.drag["i"]
            self.shape[i], self.drag["anchor"] = transform(
                self.shape[i], self.drag["anchor"], kind)
            self.redraw()
            return
        hit = self.hit_piece(x, y)
        if not hit:
            return
        i, anchor, src = hit
        if src == "tray":
            self.shape[i] = transform(self.shape[i], anchor, kind)[0]
        else:
            cells = self.placed[i]
            mr = min(r for r, c in cells)
            mc = min(c for r, c in cells)
            hot = (mr + anchor[0], mc + anchor[1])
            new, na = transform(normalize(cells), anchor, kind)
            moved = [(hot[0] - na[0] + r, hot[1] - na[1] + c) for r, c in new]
            taken = {p for j, cs in self.placed.items() if j != i for p in cs}
            if all(p in self.layout.cells and p not in taken for p in moved):
                self.placed[i] = moved
                self.shape[i] = new
                self.hint_steps = []
        self.refresh()

    def on_key(self, e):
        k = e.keysym.lower()
        if k == "r":
            self.transform_at(self.mx, self.my, "rot")
        elif k == "f":
            self.transform_at(self.mx, self.my, "flip")
        elif k == "h":
            self.hint()

    def undo(self):
        """Take back the last piece you placed (card pieces stay)."""
        if self.solving:
            return
        while self.history:
            i = self.history.pop()
            if i in self.placed and i not in self.fixed:
                del self.placed[i]
                self.hint_steps = []
                self.set_status(f"Removed the {self.pieces[i]['name']} piece.")
                break
        self.refresh()

    def reset_card(self):
        """Start the current puzzle (or an empty free-play board) again."""
        self.load_card(self.current)

    def set_status(self, text):
        self.status.config(text=text)

    def check_solved(self):
        if len(self.placed) < len(self.pieces):
            return
        if {p for cs in self.placed.values() for p in cs} != set(self.layout.cells):
            return
        self.stop_timer()
        t = self.timer_label.cget("text")
        self.set_status(f"Solved! Time {t}.")
        messagebox.showinfo("Solved!", f"Congratulations - puzzle solved!\nTime: {t}")

    # ---------------------------------------------------- layout / cards
    def change_layout(self, idx):
        layout = LAYOUTS[idx]
        if self.solving or layout is self.layout:
            self.layout_var.set(self.layout.name)
            return
        self.set_layout(layout)

    def set_layout(self, layout):
        use_layout(layout)
        self.layout = layout
        self.layout_var.set(layout.name)
        self.table = build_placements(self.pieces)
        cw, ch = self.canvas_size()
        self.cv.config(width=cw, height=ch)
        self.place_panel()
        self.card_box.config(values=[FREE] + [c[0] for c in layout.cards])
        self.load_card(0)

    def load_card(self, idx):
        """idx 0 = free play (empty board), idx n = puzzle card n."""
        if self.solving or idx < 0:
            return
        self.current = idx
        self.hint_steps = []
        self.drag = None
        self.history = []
        self.shape = [normalize(p["cells"]) for p in self.pieces]
        bad = []
        if idx == 0:
            self.placed, self.fixed = {}, set()
            self.card_var.set(FREE)
            self.set_status(f"Free play on the {self.layout.name} board - drag pieces onto "
                            "it. Press Hint whenever you want help.")
        else:
            label, rows = self.layout.cards[idx - 1]
            found, bad = card_pieces(rows, self.pieces)
            self.placed, self.fixed = found, set(found)
            for i, cells in found.items():
                self.shape[i] = normalize(cells)
            self.card_var.set(label)
            self.set_status(f"Puzzle {label}: place the {len(self.pieces) - len(found)} "
                            "remaining pieces. Press Hint if you get stuck.")
        self.reset_timer()
        self.refresh()
        if bad:
            messagebox.showwarning(
                "Shape mismatch",
                "These pieces on the card don't match your current piece shapes: "
                + ", ".join(bad) + ".\nCheck Pieces > Edit piece shapes...")

    # ------------------------------------------------------- hints
    def hint(self):
        """Show one more step of the solution (each press reveals the next one)."""
        self.request_hint(len(self.hint_steps) + 1)

    def show_all(self):
        """Show every remaining piece, numbered in the order to place them."""
        self.request_hint(None)

    def request_hint(self, limit):
        if self.solving:
            return
        if len(self.placed) == len(self.pieces):
            self.set_status("Every piece is already on the board.")
            return
        filled = 0
        for cells in self.placed.values():
            for r, c in cells:
                filled |= bit(r, c)
        rem = sum(1 << i for i in range(len(self.pieces)) if i not in self.placed)
        sizes = [len(p["cells"]) for p in self.pieces]
        names = [p["name"] for p in self.pieces]
        table = self.table
        deadline = time.time() + 90
        self.cancel.clear()
        self.solving = True
        self.set_status("Thinking... (normally well under a second)")
        self.refresh()

        def work():
            steps, err = None, None
            try:
                res = solve(table, sizes, filled, rem, None, deadline, self.cancel)
                if res:
                    steps = plan_hints(table, sizes, filled, rem, res, names,
                                       self.cancel, limit)
            except Cancelled:
                err = "cancel"
            except TimeoutError:
                err = "timeout"
            self.root.after(0, lambda: self.hint_done(steps, err, limit))

        threading.Thread(target=work, daemon=True).start()

    def hint_done(self, steps, err, limit):
        self.solving = False
        if err == "timeout":
            self.set_status("No hint found in time.")
            messagebox.showwarning("Solver", "The solver gave up after 90 s.")
        elif err is None and steps is None:
            self.set_status("These pieces can't all fit together - press Undo to take "
                            "back the last piece(s), then ask again.")
            messagebox.showwarning(
                "No solution",
                "The pieces on the board can't be completed.\n\nPress Undo to take back "
                "your last piece(s) and ask for a hint again.")
        elif steps:
            self.hint_steps = steps
            if limit is None:
                self.set_status(f"Solution: {len(steps)} piece(s) left, numbered in the "
                                "order to place them.")
            else:
                name = self.pieces[steps[-1]["piece"]]["name"]
                self.set_status(f"Hint {len(steps)}: place the {name} piece (gold outline). "
                                "Press Hint again for the next one.")
        self.refresh()

    # ---------------------------------------------------- piece editor
    def open_editor(self):
        if self.solving:
            return
        PieceEditor(self)

    def set_pieces(self, shapes):
        for p, cells in zip(self.pieces, shapes):
            p["cells"] = normalize(cells)
        save_pieces(self.pieces)
        self.table = build_placements(self.pieces)
        self.load_card(0)
        total = sum(len(p["cells"]) for p in self.pieces)
        if total != len(LAYOUT.cells):
            messagebox.showwarning(
                "Piece total", f"The pieces cover {total} cells, but the board has "
                               f"{len(LAYOUT.cells)}. A complete solution is impossible until "
                               "the totals match.")
        self.set_status("Piece shapes updated - board cleared.")


class PieceEditor(tk.Toplevel):
    G, S = 6, 38

    def __init__(self, app):
        super().__init__(app.root)
        self.app = app
        self.title("Edit piece shapes")
        self.transient(app.root)
        self.resizable(False, False)
        self.work = [set(p["cells"]) for p in app.pieces]
        self.sel = 0

        left = ttk.Frame(self, padding=8)
        left.grid(row=0, column=0, sticky="n")
        self.lb = tk.Listbox(left, exportselection=False, height=12, width=14)
        for p in app.pieces:
            self.lb.insert("end", p["name"])
        self.lb.selection_set(0)
        self.lb.bind("<<ListboxSelect>>", self.on_pick)
        self.lb.pack()

        right = ttk.Frame(self, padding=8)
        right.grid(row=0, column=1)
        ttk.Label(right, text="Click squares to toggle them.").pack(anchor="w")
        self.cv = tk.Canvas(right, width=self.G * self.S, height=self.G * self.S,
                            bg="#eceff1", highlightthickness=0)
        self.cv.pack(pady=4)
        self.cv.bind("<Button-1>", self.toggle)
        self.info = ttk.Label(right, text="")
        self.info.pack(anchor="w")
        row = ttk.Frame(right)
        row.pack(fill="x", pady=(8, 0))
        ttk.Button(row, text="Restore defaults", command=self.defaults).pack(side="left")
        ttk.Button(row, text="Cancel", command=self.destroy).pack(side="right")
        ttk.Button(row, text="Apply", command=self.apply).pack(side="right", padx=4)
        self.draw()

    def on_pick(self, _):
        sel = self.lb.curselection()
        if sel:
            self.sel = sel[0]
            self.draw()

    def toggle(self, e):
        c, r = e.x // self.S, e.y // self.S
        if 0 <= r < self.G and 0 <= c < self.G:
            self.work[self.sel] ^= {(r, c)}
            self.draw()

    def draw(self):
        self.cv.delete("all")
        S = self.S
        for i in range(self.G + 1):
            self.cv.create_line(i * S, 0, i * S, self.G * S, fill="#b0bec5")
            self.cv.create_line(0, i * S, self.G * S, i * S, fill="#b0bec5")
        col = self.app.pieces[self.sel]["color"]
        for r, c in self.work[self.sel]:
            self.cv.create_oval(c * S + 3, r * S + 3, (c + 1) * S - 3, (r + 1) * S - 3,
                                fill=col, outline="#555")
        total = sum(len(w) for w in self.work)
        self.info.config(
            text=f"{self.app.pieces[self.sel]['name']}: {len(self.work[self.sel])} squares   |   "
                 f"all pieces: {total} (board needs {len(LAYOUT.cells)})",
            foreground="#000" if total == len(LAYOUT.cells) else "#c62828")

    def defaults(self):
        self.work = [set(normalize(parse(a))) for _, _, a in DEFAULT_PIECES]
        self.draw()

    def apply(self):
        for p, w in zip(self.app.pieces, self.work):
            if not w or not is_connected(w):
                messagebox.showerror("Invalid shape",
                                     f"'{p['name']}' must be one connected group of squares.",
                                     parent=self)
                return
        self.app.set_pieces([sorted(w) for w in self.work])
        self.destroy()


