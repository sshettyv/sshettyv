def load_pieces():
    pieces = [{"name": n, "color": col, "cells": normalize(parse(a))}
              for n, col, a in DEFAULT_PIECES]
    try:
        with open(CONFIG, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        for p in pieces:
            raw = data.get(p["name"])
            if raw:
                cells = normalize([(int(r), int(c)) for r, c in raw])
                if is_connected(cells):
                    p["cells"] = cells
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        pass
    return pieces


def save_pieces(pieces):
    try:
        with open(CONFIG, "w", encoding="utf-8") as fh:
            json.dump({p["name"]: [list(c) for c in p["cells"]] for p in pieces}, fh)
    except OSError:
        pass


