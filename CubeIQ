LEVELS = [("Starter", 1, 18), ("Junior", 19, 36), ("Expert", 37, 54),
          ("Master", 55, 72), ("Wizard", 73, 90)]


def level_of(n):
    for name, a, b in LEVELS:
        if a <= n <= b:
            return name


FREE = "Free play"
CHOICES = [FREE] + [f"{n}  ({level_of(n)})" for n in range(1, 91)]


# ------------------------------------------------------------ geometry helpers
def normalize(cells, anchor=None):
    mr = min(r for r, c in cells)
    mc = min(c for r, c in cells)
    cells = frozenset((r - mr, c - mc) for r, c in cells)
    if anchor is not None:
        return cells, (anchor[0] - mr, anchor[1] - mc)
    return cells


def rotate(cells, anchor):
    return normalize([(c, -r) for r, c in cells], (anchor[1], -anchor[0]))


def flip(cells, anchor):
    return normalize([(r, -c) for r, c in cells], (anchor[0], -anchor[1]))


def all_orientations(cells):
    s, a, out = normalize(cells), (0, 0), set()
    for _ in range(2):
        for _ in range(4):
            out.add(s)
            s, a = rotate(s, a)
        s, a = flip(s, a)
    return out


ORIENT = {n: all_orientations(RAW[n][1]) for n in NAMES}


def origin_of(cells):
    return min(r for r, c in cells), min(c for r, c in cells)


# ------------------------------------------------------------------- solver
def solve(locked):
    """locked: {name: set(cells)}.  Returns {name: set(cells)} for the rest,
    or None if there is no solution."""
    occ = set(BLOCKED)
    for cells in locked.values():
        occ |= cells
    unused = frozenset(n for n in NAMES if n not in locked)
    rel = {n: [sorted(o) for o in ORIENT[n]] for n in NAMES}

    def rec(occ, unused):
        spot = next(((r, c) for r in range(ROWS) for c in range(COLS)
                     if (r, c) not in occ), None)
        if spot is None:
            return {} if not unused else None
        if not unused:
            return None
        for n in unused:
            for shape in rel[n]:
                fr, fc = shape[0]        # first cell in row-major order
                cells = {(spot[0] + r - fr, spot[1] + c - fc) for r, c in shape}
                if all(0 <= r < ROWS and 0 <= c < COLS and (r, c) not in occ
                       for r, c in cells):
                    res = rec(occ | cells, unused - {n})
                    if res is not None:
                        res[n] = cells
                        return res
        return None

    return rec(frozenset(occ), unused)


class Game:
    def __init__(self, root):
        self.root = root
        root.title("IQ Quub - Python edition")
        self.color = {n: RAW[n][0] for n in NAMES}
        self.challenge = 0
        self.solution_cache = {}
        rows_tray = -(-len(NAMES) // TRAY_COLS)
        self.canvas = tk.Canvas(root, width=TX + TRAY_COLS * SLOT_W + 10,
                                height=max(BY + ROWS * CELL + 20, TY + rows_tray * SLOT_H + 10), bg="#fafafa",
                                highlightthickness=0)
        self.canvas.pack(side="top")
        # control panel: sits in the empty tray slots under the last piece
        bg = "#fafafa"
        panel = tk.Frame(self.canvas, bg=bg)
        panel.place(x=TX + SLOT_W, y=TY + (len(NAMES) // TRAY_COLS) * SLOT_H,
                    width=(TRAY_COLS - 1) * SLOT_W - 8, height=SLOT_H - 8)

        row1 = tk.Frame(panel, bg=bg)
        row1.pack(fill="x", pady=(2, 3))
        tk.Button(row1, text="Reset", width=7, command=self.reset).pack(side="left", padx=2)
        tk.Label(row1, text="Challenge:", bg=bg).pack(side="left", padx=(6, 2))
        self.combo = ttk.Combobox(row1, values=CHOICES, state="readonly", width=12)
        self.combo.current(0)
        self.combo.pack(side="left")
        self.combo.bind("<<ComboboxSelected>>", self.on_choose)

        row2 = tk.Frame(panel, bg=bg)
        row2.pack(fill="x", pady=3)
        for text, cmd in (("Hint", self.hint), ("Solution", self.show_solution),
                          ("Undo", self.undo)):
            tk.Button(row2, text=text, width=7, command=cmd).pack(side="left", padx=2)

        row3 = tk.Frame(panel, bg=bg)
        row3.pack(fill="x", pady=3)
        tk.Label(row3, text="Timer:", bg=bg, font=("Arial", 18, "bold")).pack(side="left", padx=(4, 6))
        self.timer_label = tk.Label(row3, text="00:00", width=7, bg=bg,
                                    font=("Courier", 25, "bold"))
        self.timer_label.pack(side="left")

        self.status = tk.Label(panel, text="", bg=bg, anchor="w")
        self.status.pack(fill="x", padx=6)
        self.running = False
        self.armed = True         # auto-start on the first piece move after a reset
        self.elapsed = 0.0
        self.t0 = 0.0
        self.tick()

        self.canvas.bind("<ButtonPress-1>", self.on_press)
        self.canvas.bind("<B1-Motion>", self.on_move)
        self.canvas.bind("<ButtonRelease-1>", self.on_release)
        self.canvas.bind("<Button-3>", lambda e: self.transform_at(e.x, e.y, rotate))
        self.canvas.bind("<Button-2>", lambda e: self.transform_at(e.x, e.y, rotate))  # macOS
        root.bind("<Key-r>", lambda e: self.transform_at(self.mx, self.my, rotate))
        root.bind("<Key-f>", lambda e: self.transform_at(self.mx, self.my, flip))
        self.canvas.bind("<Motion>", self.track)
        self.mx = self.my = 0
        self.reset()

    # ------------------------------------------------------------ challenges
    def on_choose(self, _e=None):
        i = self.combo.current()
        self.challenge = i            # 0 = free play, 1..90 = challenge number
        self.reset()

    # ----------------------------------------------------------------- timer
    def timer_start(self):
        if not self.running:
            self.armed = False
            self.running = True
            self.t0 = time.time() - self.elapsed

    def timer_auto_start(self):
        """Start the timer on the first piece move after a reset / new challenge."""
        if self.armed:
            self.timer_start()

    def timer_stop(self):
        if self.running:
            self.elapsed = time.time() - self.t0
            self.running = False
            self.show_time()

    def timer_reset(self):
        self.armed = True
        self.running = False
        self.elapsed = 0.0
        self.show_time()

    def show_time(self):
        t = int(time.time() - self.t0 if self.running else self.elapsed)
        h, rem = divmod(t, 3600)
        m, s = divmod(rem, 60)
        self.timer_label.config(text=f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}")

    def tick(self):
        self.show_time()
        self.root.after(200, self.tick)

    # ------------------------------------------------------------------ undo
    def undo(self):
        while self.history:
            n = self.history.pop()
            if n not in self.locked and self.placed[n] is not None:
                self.placed[n] = None
                break
        self.update_status()
        self.draw()

    def remember(self, n):
        if n in self.history:
            self.history.remove(n)
        self.history.append(n)

    def reset(self):
        self.shape = {}
        self.placed = {n: None for n in NAMES}     # name -> (r0, c0)
        self.locked = set()
        self.history = []          # order in which pieces were placed
        self.drag = None
        self.timer_reset()
        # tray pieces start in different orientations
        for i, n in enumerate(NAMES):
            s, a = normalize(RAW[n][1]), (0, 0)
            for _ in range(i % 4):
                s, a = rotate(s, a)
            self.shape[n] = s
        # pre-placed (locked) pieces of the chosen challenge
        for n, cells in CHALLENGES.get(self.challenge, {}).items():
            self.shape[n] = normalize(cells)
            self.placed[n] = origin_of(cells)
            self.locked.add(n)
        self.update_status()
        self.draw()

    def cells_of(self, name):
        r0, c0 = self.placed[name]
        return {(r + r0, c + c0) for r, c in self.shape[name]}

    def occupied(self, skip=None):
        occ = set()
        for n in NAMES:
            if n != skip and self.placed[n] is not None:
                occ |= self.cells_of(n)
        return occ

    def valid(self, name, shape, r0, c0):
        occ = self.occupied(skip=name)
        for r, c in shape:
            rr, cc = r + r0, c + c0
            if not (0 <= rr < ROWS and 0 <= cc < COLS):
                return False
            if (rr, cc) in BLOCKED or (rr, cc) in occ:
                return False
        return True

    def update_status(self):
        n = sum(1 for v in self.placed.values() if v is not None)
        self.status.config(text=f"Placed {n}/{len(NAMES)}")

    # ------------------------------------------------------------ geometry
    def slot_xy(self, i):
        return TX + (i % TRAY_COLS) * SLOT_W, TY + (i // TRAY_COLS) * SLOT_H

    def board_cell(self, x, y):
        return (y - BY) // CELL, (x - BX) // CELL

    def hit_piece(self, x, y):
        """Return (name, anchor_cell, source) for a movable piece under (x, y)."""
        r, c = self.board_cell(x, y)
        for n in NAMES:
            if n in self.locked:
                continue
            if self.placed[n] is not None and (r, c) in self.cells_of(n):
                r0, c0 = self.placed[n]
                return n, (r - r0, c - c0), "board"
        for i, n in enumerate(NAMES):
            if self.placed[n] is None:
                sx, sy = self.slot_xy(i)
                for (cr, cc) in self.shape[n]:
                    x0, y0 = sx + cc * TS, sy + cr * TS
                    if x0 <= x < x0 + TS and y0 <= y < y0 + TS:
                        return n, (cr, cc), "tray"
        return None

    # -------------------------------------------------------------- events
    def track(self, e):
        self.mx, self.my = e.x, e.y

    def on_press(self, e):
        self.track(e)
        hit = self.hit_piece(e.x, e.y)
        if not hit:
            return
        name, anchor, src = hit
        self.timer_auto_start()
        self.placed[name] = None
        if name in self.history:
            self.history.remove(name)
        self.drag = {"name": name, "anchor": anchor}
        self.draw()

    def on_move(self, e):
        self.track(e)
        if self.drag:
            self.draw()

    def on_release(self, e):
        self.track(e)
        d = self.drag
        if not d:
            return
        n = d["name"]
        r, c = self.board_cell(e.x, e.y)
        r0, c0 = r - d["anchor"][0], c - d["anchor"][1]
        if self.valid(n, self.shape[n], r0, c0):
            self.placed[n] = (r0, c0)
            self.remember(n)
        # otherwise the piece goes back to the tray
        self.drag = None
        self.update_status()
        self.draw()
        if all(v is not None for v in self.placed.values()):
            self.timer_stop()
            t = self.timer_label.cget("text")
            messagebox.showinfo("Solved!",
                                f"Congratulations - you solved the puzzle!\nTime: {t}")

    def transform_at(self, x, y, fn):
        if self.drag:
            n = self.drag["name"]
            self.shape[n], self.drag["anchor"] = fn(self.shape[n], self.drag["anchor"])
            self.draw()
            return
        hit = self.hit_piece(x, y)
        if not hit:
            return
        n, anchor, src = hit
        new_shape, new_anchor = fn(self.shape[n], anchor)
        if src == "tray":
            self.shape[n] = new_shape
        else:
            r0, c0 = self.placed[n]
            r, c = r0 + anchor[0], c0 + anchor[1]
            nr0, nc0 = r - new_anchor[0], c - new_anchor[1]
            if self.valid(n, new_shape, nr0, nc0):
                self.shape[n] = new_shape
                self.placed[n] = (nr0, nc0)
                self.timer_auto_start()
        self.draw()

    # ------------------------------------------------------------- helpers
    def get_solution(self):
        """Solution of the current challenge: {name: cells} for ALL pieces."""
        if self.challenge not in self.solution_cache:
            locked = {n: set(c) for n, c in CHALLENGES.get(self.challenge, {}).items()}
            if self.challenge == 0:
                rest = {n: set(RAW[n][1]) for n in NAMES}
            else:
                rest = solve(locked)
                if rest is None:
                    messagebox.showwarning("No solution",
                                           "No solution found for this challenge.")
                    return None
                rest = {**rest, **locked}
            self.solution_cache[self.challenge] = rest
        return self.solution_cache[self.challenge]

    def put(self, n, cells):
        self.shape[n] = normalize(cells)
        self.placed[n] = origin_of(cells)

    def hint(self):
        sol = self.get_solution()
        if not sol:
            return
        for n in NAMES:
            if n in self.locked:
                continue
            cells = sol[n]
            if self.placed[n] is not None and self.cells_of(n) == cells:
                continue
            self.placed[n] = None
            for m in NAMES:                   # clear whatever is in the way
                if m not in self.locked and self.placed[m] is not None \
                        and self.cells_of(m) & cells:
                    self.placed[m] = None
            self.put(n, cells)
            self.remember(n)
            break
        self.update_status()
        self.draw()

    def show_solution(self):
        sol = self.get_solution()
        if not sol:
            return
        for n in NAMES:
            if n not in self.locked:
                self.put(n, sol[n])
                self.remember(n)
        self.update_status()
        self.draw()

    # ------------------------------------------------------------- drawing
    def draw_cell(self, x, y, size, color, outline="white"):
        self.canvas.create_rectangle(x + 1, y + 1, x + size - 1, y + size - 1,
                                     fill=color, outline=outline, width=2)

    def draw(self):
        cv = self.canvas
        cv.delete("all")
        # board: dark plate, free cells dark, grey pegs and white blocks
        cv.create_rectangle(BX - 4, BY - 4, BX + COLS * CELL + 4, BY + ROWS * CELL + 4,
                            fill="#231f20", outline="")
        for (r, c) in BLOCKED:
            x, y = BX + c * CELL, BY + r * CELL
            col = "#ffffff" if (r, c) in WHITE else "#6d6e71"
            cv.create_rectangle(x + 1, y + 1, x + CELL - 1, y + CELL - 1,
                                fill=col, outline="")
        # placed pieces
        for n in NAMES:
            if self.placed[n] is not None:
                edge = "#231f20" if n in self.locked else "white"
                for r, c in self.cells_of(n):
                    self.draw_cell(BX + c * CELL, BY + r * CELL, CELL,
                                   self.color[n], edge)
        # tray
        title = "Pieces (right-click / R = rotate, F = flip)"
        if self.challenge:
            title = f"Challenge {self.challenge} - {level_of(self.challenge)}   |   " + title
        cv.create_text(TX, 25, anchor="w", text=title, font=("Arial", 9, "bold"))
        for i, n in enumerate(NAMES):
            sx, sy = self.slot_xy(i)
            cv.create_rectangle(sx - 4, sy - 4, sx + SLOT_W - 8, sy + SLOT_H - 8,
                                outline="#e3e3e3")
            if self.placed[n] is None and not (self.drag and self.drag["name"] == n):
                for r, c in self.shape[n]:
                    self.draw_cell(sx + c * TS, sy + r * TS, TS, self.color[n])
        # dragged piece + ghost
        if self.drag:
            n, a = self.drag["name"], self.drag["anchor"]
            r, c = self.board_cell(self.mx, self.my)
            r0, c0 = r - a[0], c - a[1]
            ok = self.valid(n, self.shape[n], r0, c0)
            for rr, cc in self.shape[n]:
                x, y = BX + (cc + c0) * CELL, BY + (rr + r0) * CELL
                cv.create_rectangle(x + 2, y + 2, x + CELL - 2, y + CELL - 2,
                                    outline="#22aa22" if ok else "#dd2222",
                                    width=3, dash=(4, 3))
            for rr, cc in self.shape[n]:
                x = self.mx + (cc - a[1] - 0.5) * CELL
                y = self.my + (rr - a[0] - 0.5) * CELL
                self.draw_cell(x, y, CELL, self.color[n])


